{
  "name": "@light4/pi-goal",
  "version": "0.1.0",
  "packageManager": "pnpm@12.10.1",
  "description": "Turn goals into actionable AI tasks with /goal in Pi",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "goal"],
  "license": "MIT",
  "files": ["src", "snippets"],
  "publishConfig": { "access": "public" },
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": {
    "test": "pnpm test:e2e",
    "test:e2e": "node --test e2e/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm typecheck && pnpm test:e2e"
  },
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*", "@earendil-works/pi-ai": "*", "@earendil-works/pi-tui": "*", "typebox": "*" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "typebox": "^1.0.0"
  }
}
